generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MedicalSystem {
  SIDDHA
  AYURVEDA
  PROPRIETARY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  UPI
  CARDS
  COD
}

enum AddressType {
  HOME
  WORK
  OTHER
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Ruthra Master Admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model Category {
  id            String         @id @default(uuid())
  slug          String         @unique
  title         String
  titleTa       String
  medicalSystem MedicalSystem  @default(SIDDHA)
  description   String?
  itemCount     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([medicalSystem])
  @@index([slug])
  @@map("categories")
}

model Product {
  id                 String         @id // e.g. prod-siddha-001 or prod-prop-01
  name               String
  tamilName          String
  slug               String         @unique
  medicalSystem      MedicalSystem  @default(SIDDHA)
  formulation        String
  formulationTa      String
  categoryGroup      String?        // e.g. chooranam, kudineer-chooranam, churna, tailam
  concerns           String[]       @default([])
  price              Float
  originalPrice      Float?
  packSize           String
  packSizeTa         String
  shortDescription   String
  shortDescriptionTa String
  description        String
  descriptionTa      String
  traditionalRole    String
  traditionalRoleTa  String
  badge              String?
  badgeTa            String?
  image              String
  images             String[]       @default([])
  gallery            String[]       @default([])
  isComingSoon       Boolean        @default(false)
  inStock            Boolean        @default(true)
  stock              Int            @default(20)
  featured           Boolean        @default(false)
  
  ingredients        Json           @default("[]")
  howToUse           Json           @default("[]")
  dosage             Json           @default("{}")
  safety             Json           @default("{}")
  storage            Json           @default("{}")
  faqs               Json           @default("[]")
  searchKeywords     String[]       @default([])
  tamilKeywords      String[]       @default([])

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([medicalSystem])
  @@index([categoryGroup])
  @@index([formulation])
  @@index([slug])
  @@index([inStock])
  @@map("products")
}

model Customer {
  id          String            @id @default(uuid())
  fullName    String
  phone       String            @unique
  email       String?
  addresses   CustomerAddress[]
  orders      Order[]
  totalOrders Int               @default(0)
  totalSpend  Float             @default(0.0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id          String      @id @default(uuid())
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullAddress String
  landmark    String?
  city        String
  state       String      @default("Tamil Nadu")
  pincode     String
  addressType AddressType @default(HOME)
  orders      Order[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([pincode])
  @@map("customer_addresses")
}

model Order {
  id             String           @id @default(uuid())
  orderNumber    String           @unique // e.g. RM-2026-1001
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  addressId      String?
  address        CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  
  items          OrderItem[]
  payment        Payment?
  invoice        Invoice?

  status         OrderStatus      @default(PENDING)
  subtotal       Float
  discount       Float            @default(0.0)
  deliveryCharge Float            @default(0.0)
  tax            Float            @default(0.0)
  finalTotal     Float
  
  deliveryMethod String           @default("Tamil Nadu Express Courier")
  shippingSnapshot Json           // Full address snapshot at time of order
  notes          String?
  
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String   // Reference to SKU
  productName    String   // Immutable snapshot
  tamilName      String?
  formulation    String
  packSize       String
  quantity       Int
  unitPrice      Float    // Snapshot price
  discount       Float    @default(0.0)
  lineTotal      Float
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  amount         Float
  status         PaymentStatus @default(PENDING)
  transactionRef String?
  gatewayDetails Json?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model Invoice {
  id              String   @id @default(uuid())
  invoiceNumber   String   @unique // e.g. INV-2026-1001
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issueDate       DateTime @default(now())
  subtotal        Float
  discount        Float    @default(0.0)
  deliveryCharge  Float    @default(0.0)
  tax             Float    @default(0.0)
  finalTotal      Float
  customerName    String
  customerPhone   String
  customerAddress String
  paymentMethod   String
  paymentStatus   String
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([invoiceNumber])
  @@index([issueDate])
  @@map("invoices")
}
